[Unit]
Description=Nightly PokeDumpster ownership shipment (%i)

[Timer]
# 07:00 is DERIVED from pkdump-refresh@.timer, not guessed at:
#
#   landing starts   06:00 + RandomizedDelaySec=1800  -> 06:30 at the latest
#   landing finishes + TimeoutStartSec=1800           -> 07:00 at the latest
#
# So 07:00 is the first minute at which the landing is over by its own unit's
# declared bounds. It is the same entry the derive, the price build and (until
# pd-i08u) the transform carry: the 07:00 wave is asked for together and
# systemd runs it in the order the .service files declare.
#
# This unit was at 07:30, derived from the transform, because it ran last.
# pd-i08u deleted the online holdings read, so the transform now reads what
# this unit writes and the two swapped places — the transform is the 07:30 one
# now, derived from THIS unit's bounds. tests/deploy/run.sh recomputes both
# rather than trusting these comments.
#
# It is not the guarantee, though — the ordering dependency in the .service is.
# The calendar entry only decides when the day's work is ASKED for; systemd
# decides in what order it happens.
OnCalendar=*-*-* 07:00:00
# No RandomizedDelaySec: there is no upstream to be polite to (the bucket is
# ours), and jitter would only blur the relationship to the window above — and
# to the transform's own entry, which is computed from it.
#
# Persistent, because the outbox is a queue and a missed night is a night of
# holdings the offline side does not have. Unlike the transform, a later run
# DOES catch up — it ships from the cursor, so it picks up everything the
# missed night would have — which makes Persistent=true a way of catching up
# sooner rather than the only way of catching up at all.
Persistent=true

[Install]
WantedBy=timers.target
