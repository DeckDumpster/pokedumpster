{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TenantZoneObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::{{BUCKET}}/tenant/*"
    },
    {
      "Sid": "TenantZoneListingIsPrefixScoped",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::{{BUCKET}}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "tenant/*"
        }
      }
    },
    {
      "Sid": "DenyReadingTheCatalogZoneEvenIfSomethingElseAllowsIt",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::{{BUCKET}}/raw/*",
        "arn:aws:s3:::{{BUCKET}}/lake/*"
      ]
    },
    {
      "Sid": "DenyListingTheCatalogZone",
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::{{BUCKET}}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/*",
            "lake/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyRewritingTheGovernanceItself",
      "Effect": "Deny",
      "Action": [
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::{{BUCKET}}"
    }
  ]
}
