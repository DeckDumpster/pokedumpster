[Unit]
Description=PokeDumpster failure alert for %i
# Layer 2 (pokedumpster-ivq.3). Fired via OnFailure= from the units that matter
# (the Litestream sidecar, the nightly refresh, the backup-freshness check).
# Pushes the failed unit's journal tail to Pushover the moment it fails — fast,
# detailed, on-box. Does NOT catch never-ran / box-down: that is Layer 1's job.
#
# %i is the FULL failed unit name (passed as pkdump-alert@%n.service), so this
# instance template alerts for any unit. {{REPO_DIR}} is sed-substituted by
# deploy/setup.sh (single-clone deployment).
#
# The tail goes through journal-summary.sh before it reaches alert.sh (pd-pwk8):
# raw, the last 900 bytes of a failed unit's journal are systemd boilerplate and
# podman OCI metadata, and the line that says what went wrong is buried above
# them. 80 lines rather than 20 because the filtering happens after the fetch —
# the sidecar alone prints a heartbeat every second.

[Service]
Type=oneshot
# Pushover creds are host-wide; '-' makes the file optional so the unit installs
# cleanly before alerts.env exists (alert.sh then no-ops on unset creds).
EnvironmentFile=-%h/.config/pkdump/alerts.env
ExecStart=/bin/sh -c 'journalctl --user -u %i -n 80 -o short-iso --no-pager | bash {{REPO_DIR}}/deploy/journal-summary.sh %i | bash {{REPO_DIR}}/deploy/alert.sh "PokeDumpster unit FAILED: %i"'
