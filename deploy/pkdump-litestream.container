[Unit]
Description=PokeDumpster Litestream backup sidecar ({{INSTANCE}})
# Continuously replicates the per-user collection DB to S3 (pokedumpster-8ch.3).
# The repo path + instance are sed-substituted by deploy/setup.sh — single-clone
# deployment (all instances share one checkout; only the data volume differs).
After=pkdump-{{INSTANCE}}.service network-online.target
Wants=network-online.target

[Container]
Image=docker.io/litestream/litestream:latest
Exec=replicate -config /etc/litestream.yml

# Same data volume as the app — read the live collection DB + its WAL (RW: the
# replica manages WAL checkpointing).
Volume=pkdump-{{INSTANCE}}-data:/data:Z
# Instance-agnostic config, mounted read-only from the single clone.
Volume={{REPO_DIR}}/deploy/litestream.yml:/etc/litestream.yml:ro
# AWS creds dir (per-instance, user-provided, never in the repo). Holds an
# assume-role profile OR a scoped static key — the credential-refresh choice is
# pokedumpster-8ch.4; this unit is agnostic to which.
Volume=%h/.config/pkdump/{{INSTANCE}}/aws:/aws:ro
Environment=AWS_CONFIG_FILE=/aws/config
Environment=AWS_SHARED_CREDENTIALS_FILE=/aws/credentials

# S3 target (bucket/region/path), DB path, and AWS_PROFILE — user-provided.
EnvironmentFile=%h/.config/pkdump/{{INSTANCE}}/litestream.env

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
