[Unit]
Description=Nightly PokeDumpster offline catalog derive (%i)

[Timer]
# 07:00 is DERIVED from pkdump-refresh@.timer, not guessed at:
#
#   landing starts   06:00 + RandomizedDelaySec=1800  -> 06:30 at the latest
#   landing finishes + TimeoutStartSec=1800           -> 07:00 at the latest
#
# So 07:00 is the first minute at which the landing is over by its own unit's
# declared bounds. Change either number there and this one follows —
# tests/deploy/run.sh recomputes it rather than trusting the comment.
#
# It is not the guarantee, though — the ordering dependency in the .service is.
# The calendar entry only decides when the day's work is ASKED for; systemd
# decides in what order it happens.
#
# The transform tier (pkdump-value-snapshots@.timer) is also at 07:00, and that
# is fine: it is ordered After= this unit, so the three jobs run land -> derive
# -> transform in sequence however long each takes.
OnCalendar=*-*-* 07:00:00
# No RandomizedDelaySec: unlike the landing there is no upstream to be polite to
# — everything this job reads is the bucket and the box's own SQLite — and
# jitter would only blur the relationship to the window above.
#
# Persistent, because each run derives exactly the date it is asked for and
# nothing later fills a missed one in. A box that was off at 07:00 derives when
# it comes back; a day missed entirely is rebuildable by hand for as long as the
# lake holds it, which is forever (raw/ has no lifecycle rule) — see
# deploy/LAKE.md.
Persistent=true

[Install]
WantedBy=timers.target
