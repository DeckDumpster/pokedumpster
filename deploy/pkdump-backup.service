[Unit]
Description=PokeDumpster backup (%i)

[Service]
Type=oneshot
# %i is the instance name (e.g. prod), passed to backup.sh. {{REPO_DIR}} is
# substituted by deploy/setup.sh with the actual repo clone path — this is a
# single-clone deployment (all instances share one checkout; only the data
# volume differs), so the clone is NOT named per-instance.
WorkingDirectory={{REPO_DIR}}
ExecStart={{REPO_DIR}}/deploy/backup.sh %i
TimeoutStartSec=900
