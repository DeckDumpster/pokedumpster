[Unit]
Description=Nightly PokeDumpster catalog.prices build (%i)

[Timer]
# 07:00 is DERIVED from pkdump-refresh@.timer, not guessed at:
#
#   landing starts   06:00 + RandomizedDelaySec=1800  -> 06:30 at the latest
#   landing finishes + TimeoutStartSec=1800           -> 07:00 at the latest
#
# So 07:00 is the first minute at which the landing is over by its own unit's
# declared bounds. Change either number there and this one follows —
# tests/deploy/run.sh recomputes it rather than trusting the comment.
#
# It is not the guarantee, though — the ordering dependencies in the .service
# are. The derive and the transform are also at 07:00, and that is fine: all
# three are ordered, so the night runs land -> derive -> prices -> transform in
# sequence however long each takes. The calendar entry only decides when the
# day's work is ASKED for; systemd decides in what order it happens.
OnCalendar=*-*-* 07:00:00
# No RandomizedDelaySec: unlike the landing there is no upstream to be polite to
# — everything this job reads is the bucket and the box's own catalog — and
# jitter would only blur the relationship to the window above.
#
# Persistent, because each run builds exactly the date it is asked for and
# nothing later fills a missed one in. A box that was off at 07:00 builds when
# it comes back; a day missed entirely is rebuildable by hand for as long as the
# lake holds it, which is forever (raw/ has no lifecycle rule) — see
# deploy/LAKE.md §6.
Persistent=true

[Install]
WantedBy=timers.target
